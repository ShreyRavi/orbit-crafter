{
  "name": "orbitcraft-webgpu",
  "version": "1.0.0",
  "description": "Real-time GPU-accelerated N-body physics universe sandbox",
  "type": "module",
  "scripts": {
    "dev":       "vite",
    "build":     "tsc --noEmit && vite build",
    "preview":   "vite preview",
    "typecheck": "tsc --noEmit",
    "test":      "vitest",
    "test:run":  "vitest run",
    "test:ui":   "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.69",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^4.1.4"
  }
}
